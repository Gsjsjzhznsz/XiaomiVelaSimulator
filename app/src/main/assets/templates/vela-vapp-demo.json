  "os": "Xiaomi VELA OS (NuttX + QuickJS + LVGL)",
  "screen": {
    "shape": "round",
    "sizeInch": 1.43,
    "width": 466,
    "height": 466,
    "dpi": 326,
    "bezelPx": 10,
