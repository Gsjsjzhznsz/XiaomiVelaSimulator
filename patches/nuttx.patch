+/****************************************************************************
+ * Name: virtio_kmm_alloc_buf
+ *
+ * The 4-argument virtio_alloc_buf() of the original NuttX API no longer
+ * has an implementation in this fork (the name now resolves to the
+ * open-amp inline helper with a different signature). Allocate directly
+ * from the kmm heap instead; on FLAT builds VA == PA, which is what the
+ * virtio host side requires.
+ ****************************************************************************/
+
+static inline_function int virtio_kmm_alloc_buf(FAR struct virtio_device *vdev,
+                                                FAR void **buf, size_t size,
+                                                size_t align)
+{
+  FAR void *p;
+
+  (void)vdev;
+
+  if (align < sizeof(void *))
+    {
+      align = sizeof(void *);
+    }
+
+  p = kmm_memalign(align, size);
+  if (p == NULL)
+    {
+      return -ENOMEM;
+    }
+
+  *buf = p;
+  return 0;
+}
+
 static inline_function FAR void *
 virtio_malloc_buf(FAR struct virtio_device *vdev, size_t size, size_t align)
 {
   FAR void *buf;
 
-  if (virtio_alloc_buf(vdev, &buf, size, align) < 0)
+  if (virtio_kmm_alloc_buf(vdev, &buf, size, align) < 0)
     {
       return NULL;
     }
@@ -195,7 +228,7 @@ virtio_zalloc_buf(FAR struct virtio_device *vdev, size_t size, size_t align)
 {
   FAR void *buf;
 
-  if (virtio_alloc_buf(vdev, &buf, size, align) < 0)
+  if (virtio_kmm_alloc_buf(vdev, &buf, size, align) < 0)
     {
       return NULL;
     }
